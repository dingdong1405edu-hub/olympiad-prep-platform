# ============================================================
# Cấu hình môi trường — copy file này thành `.env` rồi chỉnh
# ============================================================

# --- Database (PostgreSQL 16) ---
# Khớp với docker-compose.yml — container publish ra cổng 5433 để không đụng
# PostgreSQL cài sẵn trên máy (thường chiếm 5432). Dùng Postgres riêng thì sửa lại chuỗi này.
DATABASE_URL="postgresql://olympiad:olympiad_dev_password@localhost:5433/olympiad?schema=public"

# --- Auth ---
# BẮT BUỘC đổi ở production. Tạo chuỗi ngẫu nhiên >= 32 ký tự.
AUTH_SECRET="doi-chuoi-nay-thanh-mot-gia-tri-ngau-nhien-dai-it-nhat-32-ky-tu"
AUTH_TOKEN_TTL_HOURS="72"

# --- AI (tùy chọn) ---
# Không có key: hệ thống tự chạy fallback template từ dữ liệu có cấu trúc,
# mọi tính năng vẫn hoạt động, chỉ khác ở văn phong nhận xét.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
AI_MODEL_CHEAP="claude-haiku-4-5-20251001"
AI_ENABLED="true"

# --- Ứng dụng ---
NEXT_PUBLIC_APP_NAME="Olympiad Prep"
APP_TIMEZONE="Asia/Ho_Chi_Minh"

# URL gốc của ứng dụng. Dùng để dựng returnUrl/cancelUrl gửi sang cổng thanh toán
# và để in ra URL webhook. Trên Railway có thể bỏ trống — hệ thống tự lấy
# RAILWAY_PUBLIC_DOMAIN. Ở local thì để nguyên localhost.
APP_URL="http://localhost:3000"

# --- Thanh toán ---
# MANUAL = admin kích hoạt tay / cổng giả lập cho dev, không gọi mạng.
# PAYOS  = chuyển khoản QR, mã QR hiện ngay trên trang mình (đã tích hợp).
# VNPAY | MOMO | ZALOPAY vẫn đang trong kế hoạch (specs §20 Q5).
PAYMENT_GATEWAY="MANUAL"
# Chỉ dùng cho webhook của cổng giả lập MANUAL; PayOS ký bằng checksum key riêng.
PAYMENT_WEBHOOK_SECRET="doi-chuoi-nay-o-production"

# --- PayOS ---
# Lấy ở https://my.payos.vn → Kênh thanh toán → Thông tin xác thực.
# Thiếu bất kỳ khóa nào thì cổng PAYOS báo lỗi cấu hình chứ KHÔNG âm thầm
# rơi về cổng giả lập — tránh chuyện tưởng đã thu tiền mà thật ra chưa.
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# Đăng ký URL nhận webhook sau khi deploy:  npm run payos:webhook
# URL sẽ là:  <APP_URL>/api/v1/webhooks/payment/payos

# --- Seed ---
SEED_DEFAULT_PASSWORD="Olympiad@123"
